{
    "name": "utils",
    "displayName": "jde utils",
    "description": "",
    "version": "2026.10.0",
    "publisher": "jde",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:cpp"
    ],
    "main": "./out/src/extension",
    "contributes": {
			"commands": [
					{
							"command": "jde.repoBuildDir",
							"title": "Appends the repository directory name to the build directory path"
					},
					{
							"command": "jde.repoBuildRelDir",
							"title": "Appends the repository directory name to the release build directory path"
					}
			],
			"grammars": [
					{
							"language": "cpp",
							"scopeName": "source.cpp",
							"path": "./syntaxes/cpp.tmLanguage.json"
					}
			]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run grammar",
        "compile": "tsc -p ./",
        "grammar": "node out/scripts/grammar.js",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.105.0",
        "typescript": "^5.9.3"
    }
}
