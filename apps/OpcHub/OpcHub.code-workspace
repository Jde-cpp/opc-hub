{
	"settings": {
		"window.title": "Hub",
		"name": "OpcHub",
		"target": "Jde.Opc.Hub",
		"testTarget": "Jde.Opc.Hub.Tests",
		"subDir": "apps/${config:name}",
		"workspace": "${workspaceFolder:OpcHub}/..",
		"cmake.sourceDirectory": "${config:workspace}/../..",
		"cmake.buildDirectory": "${command:jde.repoBuildDir}",
		"search.searchView.semanticSearchBehavior": "manual",
		"github.copilot.chat.search.semanticTextResults": false,
		"settings": "${workspaceFolder:config}/Opc.Hub.jsonnet",
		"testSettings": "${workspaceFolder:tests}/config/Opc.Hub.Tests.jsonnet",
		"program": "${config:binDir}/${config:target}${config:targetExtension}"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug",
				"type": "lldb",
				"request": "launch",
				"program": "${config:cmake.buildDirectory}/debug/${config:program}",
				"args": [
					"-c",
					"-tests",
					"-settings=${workspaceFolder:config}/Opc.Hub.jsonnet",
					"-include=${config:settingsInclude}",
					"-xsync"
				],
				"cwd": "${config:cmake.buildDirectory}/debug/runtime",
				"env":{
					"REPO_SOURCE_DIR": "${config:cmake.sourceDirectory}",
					"REPO_BUILD_DIR": "${config:cmake.buildDirectory}",
				},
				"preLaunchTask": "build",
			},
			{
				"name": "Debug - Sqlite",
				"type": "lldb",
				"request": "launch",
				"program": "${config:cmake.buildDirectory}/debug/${config:program}",
				"args": [
					"-c",
					"-settings=${workspaceFolder:config}/Opc.Hub.jsonnet",
					"-tests",
					"-include=args/sqlite",
					"-arg=\"path=:memory:\""
				],
				"cwd": "${config:cmake.buildDirectory}/debug/runtime",
				"env":{
					"REPO_SOURCE_DIR": "${config:cmake.sourceDirectory}",
					"REPO_BUILD_DIR": "${config:cmake.buildDirectory}",
				},
				"preLaunchTask": "build",
			}
		],
		"compounds": []
	},
	"folders": [
		{
