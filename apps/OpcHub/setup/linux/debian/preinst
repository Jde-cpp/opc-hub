#!/bin/sh
# jde-opchub preinst.  /etc/jde-cpp/env stops being a conffile (reviews/m4-closing.md #6):  a purge deleted it, the passcode
# with it, and kept the keys under /var/lib/Jde-Cpp that only it opens.  Upgrading from a package that shipped it as one,
# the helper sets the operator's copy aside so dpkg forgets it; postinst puts it back as a plain file.  No version bound:
# once the package no longer owns the file, the helper leaves it alone.
set -e
# The binaries are built with -march=x86-64-v3 -mpclmul -maes; on a CPU without them they die on SIGILL with nothing
# logged, so refuse before anything is unpacked.  abm is lzcnt.  No /proc (a chroot):  the products' own start-up check
# still says why.
case "$1" in
	install|upgrade)
		if [ -r /proc/cpuinfo ]; then
			lacks=$(for flag in avx2 bmi1 bmi2 fma f16c movbe abm pclmulqdq aes; do grep -qw $flag /proc/cpuinfo || echo $flag; done | paste -sd' ')
			if [ -n "$lacks" ]; then
				echo "jde-opchub: this CPU lacks $lacks, which the binaries require - nothing was installed.  In a VM, choose a CPU model that passes them through (e.g. host)." >&2
				exit 1
			fi
		fi;;
esac
dpkg-maintscript-helper rm_conffile /etc/jde-cpp/env -- "$@"
exit 0
