mutation{
	createRole( slug:"viewer", name:"Viewer", description:"Reads values and browses; changes nothing. Where to put a user you haven't classified yet." )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"acl" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"groups" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"providerTypes" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"resources" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"roles" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"users" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", slug:"instances" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", slug:"instanceTagLevels" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", slug:"sessions" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"gateway", slug:"serverConnections" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"gateway", slug:"sessions" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"gateway", slug:"search" } } )
	addRole( slug:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"opc.install", slug:"nodeIds" } } )

	createRole( slug:"sa", name:"System Administrator", description:"Users, roles, permissions, certificate trust and log settings. Grants access to everyone else." )
	addRole( slug:"sa", role:{ slug:"viewer" } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"acl" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"groups" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"providerTypes" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"resources" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"roles" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", slug:"users" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"app", slug:"instances" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"app", slug:"instanceTagLevels" } } )
	addRole( slug:"sa", permissionRight:{ allowed:38, denied:0, resource:{ schemaName:"app", slug:"logs" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"app", slug:"sessions" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"serverConnections" } } )
	addRole( slug:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"opc.install", slug:"nodeIds" } } )
	addRole( slug:"sa", permissionRight:{ allowed:38, denied:0, resource:{ schemaName:"opc.install", slug:"logs" } } )

	createRole( slug:"owner", name:"Owner", description:"Every permission on every resource. Break-glass only - routine administration belongs to System Administrator." )
	addRole( slug:"owner", role:{ slug:["sa", "viewer"] } )
	addRole( slug:"owner", permissionRight:{ allowed:64, denied:0, resource:{ schemaName:"access", slug:"acl" } } )
	addRole( slug:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"access", slug:"groups" } } )
	addRole( slug:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"access", slug:"providerTypes" } } )
	addRole( slug:"owner", permissionRight:{ allowed:72, denied:0, resource:{ schemaName:"access", slug:"resources" } } )
	addRole( slug:"owner", permissionRight:{ allowed:93, denied:0, resource:{ schemaName:"access", slug:"roles" } } )
	addRole( slug:"owner", permissionRight:{ allowed:221, denied:0, resource:{ schemaName:"access", slug:"users" } } )
	addRole( slug:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"app", slug:"instances" } } )
	addRole( slug:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"app", slug:"instanceTagLevels" } } )
	addRole( slug:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"gateway", slug:"serverConnections" } } )
	addRole( slug:"owner", permissionRight:{ allowed:93, denied:0, resource:{ schemaName:"opc.install", slug:"nodeIds" } } )

	createRole( slug:"engineer", name:"Engineer", description:"Configures server connections - adds, edits and removes them. What a user may do on a connection's nodes is the OPC server's own decision, not a role's. No user administration." )
	addRole( slug:"engineer", role:{ slug:"viewer" } )
	addRole( slug:"engineer", permissionRight:{ allowed:13, denied:0, resource:{ schemaName:"gateway", slug:"serverConnections" } } )

	createRole( slug:"operator", name:"Operator", description:"Runs the process - browses and watches values. Writing a value is the OPC server's own decision, not a role's. No configuration." )
	addRole( slug:"operator", role:{ slug:"viewer" } )

	createRole( slug:"maint-tech", name:"Maintenance Technician", description:"Diagnoses faults - browses values and reads logs. Writing a value is the OPC server's own decision, not a role's. No configuration." )
	addRole( slug:"maint-tech", role:{ slug:"viewer" } )
	addRole( slug:"maint-tech", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", slug:"logs" } } )
	addRole( slug:"maint-tech", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"opc.install", slug:"logs" } } )

	createRole( slug:"gateway-instance", name:"Gateway Instance", description:"A stand-alone OPC gateway's own account - the hub's built-in gateway needs none.  Read on the access acl, groups, resources, roles and users is its access load and event subscriptions - each declares Read, so enforcing any of them stops a gateway without this role from starting.  Administer on users lets it add and remove an OPC server connection's sign-in provider.  Administer on every gateway resource lets it sync the gateway's access rows and purge a historian group's own row with the group.  Read and Update on the application server's logs load and save its log levels:  it registers no schema of its own, so its levels answer there.  Its sign-out needs no grant:  it ends a session it began.  Assign it to the gateway's user on that user's Roles tab." )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"acl" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"groups" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"resources" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", slug:"roles" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:34, denied:0, resource:{ schemaName:"access", slug:"users" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"serverConnections" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"histTemplates" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"histTemplateNodes" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"histGroups" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"histGroupNodes" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"sessions" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", slug:"search" } } )
	addRole( slug:"gateway-instance", permissionRight:{ allowed:6, denied:0, resource:{ schemaName:"app", slug:"logs" } } )
}