{
	"folders": [
		{
			"path": "my-workspace"
		}
	],
	"settings": {
		"window.title": "Web",
		"typescript.tsdk.path": "node_modules/typescript/lib",
		"typescript.tsdk.enablePromptUseWorkspaceTsdk": true
	},
	"extensions": {
		"recommendations": [
			"angular.ng-template"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [{
				"name": "Debug",
				"type": "chrome",
				"request": "launch",
				"url": "http://localhost:4200/",
				"userDataDir": "${env:HOME}/.config/vscode-chrome-debug"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "npm: start",
				"type": "shell",
				"command": "npm start",
				"options": { "cwd": "${workspaceFolder:my-workspace}" },
				"isBackground": true,
				"problemMatcher": { "owner": "typescript", "pattern": "$tsc", "background": { "activeOnStart": true, "beginsPattern": { "regexp": "Changes detected" }, "endsPattern": { "regexp": "bundle generation (complete|failed)" } } }
			},
			{
				"label": "build",
				"type": "shell",
				"command": "tput reset;ng build;",
				"problemMatcher": "$tsc",
				"group": { "kind": "build", "isDefault": true }
			}
		]
	}
}